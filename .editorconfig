root = true

[*]
charset = utf-8
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,props,targets,csproj}]
indent_size = 2

[*.cs]
resharper_csharp_max_line_length = 160

# Using directive options
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

# Prefer var whenever possible
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Indentation preferences
csharp_indent_labels = no_change

# IDE0079: Remove unnecessary suppression
dotnet_remove_unnecessary_suppression_exclusions = category:ReSharper

[tests/**.cs]
# CA1707: Identifiers should not contain underscores
# Tests follow the Method_Condition_ExpectedResult naming convention.
dotnet_diagnostic.CA1707.severity = none

# CA1304, CA1305, CA1311: culture-sensitive calls
# Tests cover all StringComparison values and change the current culture on purpose.
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1311.severity = none

# CA1866: Use char overload
# Test inputs are built per test case; the performance of test code is irrelevant.
dotnet_diagnostic.CA1866.severity = none

[benchmarks/**.cs]
# CA1707: Identifiers should not contain underscores
# Underscores keep the generated BenchmarkDotNet report readable.
dotnet_diagnostic.CA1707.severity = none

# CA1822: Mark members as static
# BenchmarkDotNet discovers instance methods and properties.
dotnet_diagnostic.CA1822.severity = none

# CA2201: Do not raise reserved exception types
# Benchmark setup throws Exception to abort a run on an unexpected parser result.
dotnet_diagnostic.CA2201.severity = none

# CA1806: Do not ignore method results
# Benchmarks intentionally ignore TryParse results.
dotnet_diagnostic.CA1806.severity = none
